// SLiM 4.3.0; parameters may be overridden using -d.
initialize() {
    initializeSLiMModelType("nonWF");
    initializeSLiMOptions(keepPedigrees=T);
    if (!exists("K")) defineConstant("K", 1000);
    if (!exists("candidateNo")) defineConstant("candidateNo", asInteger(5*K));
    if (!exists("Mu")) defineConstant("Mu", 1e-5);
    if (!exists("chromLength")) defineConstant("chromLength", 1000);
    if (!exists("selCoeff")) defineConstant("selCoeff", -0.001);
    if (!exists("domCoeff")) defineConstant("domCoeff", 0.5);
    if (!exists("rho")) defineConstant("rho", 0.5);
    if (!exists("generations")) defineConstant("generations", 30000);
    if (!exists("trackStart")) defineConstant("trackStart", 10001);
    if (!exists("trackEnd")) defineConstant("trackEnd", 15000);
    if (!exists("pathto")) defineConstant("pathto", "results");
    if (!exists("Rf")) defineConstant("Rf", 1);
    if (!exists("Df")) defineConstant("Df", 5);
    if (K < 2 | candidateNo < K | generations < trackEnd | trackStart < 2 | trackEnd < trackStart)
        stop("Invalid population size or tracking interval.");
    defineConstant("prizeMean", 1.0);
    defineConstant("prizeShape", 0.245);
    if (K % 2 != 0 | candidateNo % 2 != 0 | Rf < 1 | Rf % 2 == 0 | Df < 1 | Df >= K | Df >= candidateNo) stop("Invalid contest parameters.");
    initializeMutationType("m1", domCoeff, "f", selCoeff);
    m1.convertToSubstitution=F;
    initializeGenomicElementType("g1", 1, 1);
    initializeGenomicElement(g1, 0, chromLength-1);
    initializeRecombinationRate(rho);
    initializeMutationRate(Mu);
}

reproduction() {
	/*
	 * One SLiM cycle now represents one biological generation.
	 * K sets the founder cohort; candidateNo sets subsequent offspring cohorts.
	 *
	 * tagF stores the gamma-derived reproductive weight assigned after the
	 * previous generation's contests.  The founders have no assigned weight,
	 * so only their initial reproduction is uniform.
	 */
	parents = p1.individuals;
	if (size(parents) < 2)
		return;

	reproWeight = parents.tagF;
	if (sum(reproWeight) <= 0.0)
		reproWeight = rep(1.0 / size(parents), size(parents));
	else
		reproWeight = reproWeight / sum(reproWeight);

	sim.setValue("breederIDs", parents.pedigreeID);

	Noffspring = candidateNo;
	parentIndices = seqAlong(parents);
	contributionCounts = integer(size(parents));

	for (offspringNo in 1:Noffspring)
	{
    	// Sample both gametic contributors.
    	parent1Index = sample(parentIndices, 1, weights=reproWeight);
    	parent2Index = sample(parentIndices, 1, weights=reproWeight);

    	// Enforce no selfing BEFORE recording contributions.
    	while (parent2Index == parent1Index)
        	parent2Index = sample(parentIndices, 1, weights=reproWeight);

    	// Count only the two realised gametic contributors.
    	contributionCounts[parent1Index] =
      	contributionCounts[parent1Index] + 1;

    	contributionCounts[parent2Index] =
      	contributionCounts[parent2Index] + 1;

    	parent1 = parents[parent1Index];
    	parent2 = parents[parent2Index];


    	offspring = p1.addCrossed(parent1, parent2);

    	offspring.setValue("parent1", parent1.pedigreeID);
    	offspring.setValue("parent2", parent2.pedigreeID);
	}
	if (sum(contributionCounts) != 2 * candidateNo)
    	stop("Incorrect number of gametic contributions recorded.");

    // Mutation registration is now performed from the complete offspring
    // cohort in early(), before competition, rather than from realised parents.

    // Remove the parental generation after all offspring have been produced.


    // Prevent this population-wide reproduction routine from running again
    // for another individual during the same cycle.
    
        // POST-SELECTION LOAD
    // The parents reproducing now competed in the previous generation.

    parentGeneration = sim.cycle - 1;

    if ((parentGeneration > 0) &
        (parentGeneration % 100 == 0))
    {
        // Recover the intrinsic fitness stored before competition.
        parentFitness = float(size(parents));

        for (i in seqAlong(parents))
        {
            fitStored = parents[i].getValue("geneticFitness");

            if (isNULL(fitStored))
                parentFitness[i] = 1.0;
            else
                parentFitness[i] = fitStored;
        }

        // Output directory: Output_Load

        OUT = getWeightedParentLoad(
            parents,
            contributionCounts,
            parentGeneration,
            parentFitness
        );

        writeFile(
            paste0(pathto, "/Output_Load/", outPref, "_postselection_popLoad.txt"),
            OUT,
            append=T
        );
    }
    
    self.active = 0;
}

